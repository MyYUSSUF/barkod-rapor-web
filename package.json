{
  "name": "barkod-rapor-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/version-pwa-assets.mjs",
    "build:android": "vite build --mode android && node scripts/version-pwa-assets.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "lint": "eslint .",
    "test": "node --test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capawesome/capacitor-app-update": "^8.0.3",
    "@supabase/supabase-js": "^2.106.2",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf": "^10.4.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "tar": "7.5.22"
  }
}
